tech load SCN3ME_SUBM.30.ETRI -noprompt
#-----------------------------------------------------
# .magicrc startup file for ETRI050 project under qflow
#-----------------------------------------------------

path sys +/usr/local/share/qflow/tech/etri050
scalegrid 1 2
set GND gnd
set VDD vdd

drc euclidean on
drc off

addpath digital_ETRI

macro Control_XK_Pointer_Button4 {zoom 0.5}
macro Control_XK_Pointer_Button5 {zoom 2}
addpath /home/yosys123/Desktop/ETRI-0.5um-CMOS-MPW-Std-Cell-DK/digital_ETRI

# Qflow: read layout for review
openwrapper
box 0 0 0 0
drc off
lef read /usr/local/share/qflow/tech/etri050/etri050_stdcells.lef
load Display_optimized_auto_SPI
select top cell
expand
view
